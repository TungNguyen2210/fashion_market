cat > .gitignore << 'EOF'
# Dependencies - ignore tất cả node_modules trong mọi service
node_modules/
*/node_modules/
**/node_modules/

# Environment files - ignore tất cả file .env
.env
.env.*
*.env
**/.env
**/.env.*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Build directories
dist/
build/
out/
.cache/
.temp/
.tmp/

# Test coverage
coverage/
*.lcov
.nyc_output/

# Package manager files
.npm
.eslintcache
.stylelintcache
.yarn-integrity

# Optional npm cache directory
.npm/

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn v2
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.pnp.*

# Python (nếu có service Python)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/

# Database
*.sqlite
*.sqlite3
*.db

# Uploads folder (nếu có)
uploads/
public/uploads/
*/uploads/

# Temporary files
*.tmp
*.temp
.tmp/
.temp/
EOF